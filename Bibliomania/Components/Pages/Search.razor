@page "/search"
@rendermode InteractiveServer
@using Bibliomania.Models
@using Bibliomania.Services
@inject OpenLibraryService OpenLibrary
@inject GoogleBooksService GoogleBooks
@inject ReviewService ReviewService

<PageTitle>Library Search</PageTitle>

<h1>Library Search</h1>

<div class="input-group mb-3">
	<input class="form-control" placeholder="Search by Title/Author..." @bind="query" @bind:event="oninput">
	<button class="btn btn-primary" @onclick="SearchFunction">Search</button>
</div>

@if (warningMessage != null)
{
	<div class="alert">@warningMessage</div>	
}

@if (isLoading)
{
	<p>Perusing The Shelves...</p>
}
else if (errorMessage != null)
{
	<div class="alert">@errorMessage</div>
}
else if (books != null)
{
	@if (books.Count == 0)
	{
		<p>Not on our shelves...</p>
	}
	else
	{
		@foreach (var book in books	)
		{
			<div class="card mb-2">
				<div class="card-body d-flex">
					@if (book.BookCover != null)
					{
						<img src="@book.BookCover" alt="Cover Image" class="me-3 search-cover">
					}
					<div>
						<h5 class="card-title">@book.BookTitle</h5>
						<p class="card-text">Author: @string.Join(", ", book.Authors)</p>
						<p class="card-text">First Published: @(book.Published?.ToString() ?? "Unknown")</p>

						@if (book.Pages != null)
						{
							<p class="card-text">Pages: @book.Pages</p>
						}
						@if (!string.IsNullOrEmpty(book.Blurb))
						{
							<p class="card-text"><small>@(book.Blurb.Length > 200 ? book.Blurb[..200] + "..." : book.Blurb)</small></p>
						}
						
						@{
							var avg = ReviewService.GetAverageStars(book.Key);
							var reviews = ReviewService.GetReviews(book.Key);
						}

						@if (avg != null)
						{
							<p class="mb-1">Club rating: <strong>@avg.Value.ToString("0.0")</strong> / 5 (@reviews.Count review@(reviews.Count == 1 ? "" : "s"))</p>
						}
						else
						{
							<p class="text-muted mb-1">No club reviews yet</p>
						}

						@foreach (var r in reviews.Take(3))
						{
							<p class="mb-1"><small><strong>@r.MemberName</strong> (@r.Stars/5)@(r.ReviewText != null ? ": " + r.ReviewText : "")</small></p>
						}

						<button class="btn btn-outline-primary btn-sm" @onclick="() => OpenReview(book)">Review this book</button>

						@if (reviewingBook == book)
						{
							<div class="mt-2 border rounded p-2">
								@if (reviewError != null)
								{
									<div class="alert alert-danger py-1">@reviewError</div>
								}

								<input class="form-control mb-2" placeholder="Your name" @bind="reviewName" />

								<select class="form-select mb-2" @bind="reviewStars">
									@for (int i = 5; i >= 1; i--)
									{
										<option value="@i">@i star@(i > 1 ? "s" : "")</option>
									}
								</select>

								<textarea class="form-control mb-2" rows="2" placeholder="Comment (optional)" @bind="reviewComment"></textarea>
								<button class="btn btn-success btn-sm" @onclick="SaveReview">Save review</button>
								<button class="btn btn-link btn-sm" @onclick="CancelReview">Cancel</button>
							</div>
						}					
	
						<span class="badge bg-secondary">@book.Source</span>
					</div>	
				</div>
			</div>
		}
	}
}

@code {
	private string query = string.Empty;
	private List<Book>? books;
	private bool isLoading;
	private string? errorMessage;
	private string? warningMessage;

	private async Task SearchFunction()
	{
		if (string.IsNullOrWhiteSpace(query)) return;

		isLoading = true;
		errorMessage = null;
		warningMessage = null;
		books = new List<Book>();

		try
		{
			books.AddRange(await OpenLibrary.SearchBooksAsync(query));
		}
		catch(HttpRequestException)
		{
			warningMessage = "OpenLibrary could not be reached at this time...";	
		}

		try
		{
			books.AddRange(await GoogleBooks.SearchBooksAsync(query));
		}
		catch (HttpRequestException ex)
		{
			warningMessage += $"Google Books could not be reached ({ex.StatusCode?.ToString() ?? ex.Message}).";
		}

		if(books.Count == 0 && warningMessage != null)
		{
			errorMessage = warningMessage;
			warningMessage = null;
		}

		isLoading = false; 
	}
	
	private Book? reviewingBook;
	private string reviewName = string.Empty;
	private int reviewStars = 5;
	private string? reviewComment = "";
	private string? reviewError;

	private void OpenReview(Book book)
	{
		reviewingBook = book;
		reviewName = string.Empty;
		reviewStars = 5;
		reviewComment = string.Empty;
		reviewError = null;
	}
	private void CancelReview()
	{
		reviewingBook = null;
	}
	private void SaveReview()
	{
		if (reviewingBook == null)
		{
			reviewError = "No book selected to review...";
			return;
		}
		
		try
		{
			ReviewService.AddReview(new ClubReview
			{
				BookKey = reviewingBook.Key,
				BookTitle = reviewingBook.BookTitle,
				Authors = string.Join(", ", reviewingBook.Authors),
				BookCover = reviewingBook.BookCover,
				MemberName = reviewName,
				Stars = reviewStars,
				ReviewText = string.IsNullOrWhiteSpace(reviewComment) ? null : reviewComment.Trim()
			});
			reviewingBook = null;
		}
		catch (ArgumentException ae)
		{
			reviewError = $"Error saving review: {ae.Message}";
		}
		catch (IOException)
		{
			reviewError = "Review Couldn't be Saved, Please Try Again Later...";
		}
	}
}
