@page "/favourites"
@rendermode InteractiveServer
@using Bibliomania.Models
@using Bibliomania.Services
@inject ReviewService reviewService


<PageTitle>Favourites</PageTitle>

<h1>The Club's Top 5</h1>

@{
	var topFive = reviewService.getTopRated();
}

@if (topFive.Count == 0)
{
	<p>The Club hasn't rated any books yet, browse the stacks to add some!</p>
}
else
{
	<ol>
		@foreach (var book in topFive)
		{
			<li>
				<strong>@book.bookTitle</strong> - @book.averageRating.ToString("0.0")/5 stars (@book.count review@(book.count == 1 ? "" : "s"))
			</li>
		}
	</ol>
}

